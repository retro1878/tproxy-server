{
	email {$ACME_EMAIL}
	admin off
	servers {
		protocols h1 h2
		# Never add trusted_proxies here. The relay takes the client address from
		# X-Forwarded-For and requires it to be exactly one IP; marking a peer
		# trusted makes Caddy append rather than replace, and the relay then
		# answers 404 to the bridge and the API, which reads as the proxy
		# silently dying. Behind a CDN the field is meaningless anyway, since
		# Caddy would only ever be naming the edge, never the user.
		# read_body is a hard limit on the whole upload, so setting one caps a
		# carrier batch that is still arriving on a slow uplink - which is the
		# case the relay's own progress-resetting body deadline exists to allow.
		# Caddy has no idle-read timeout to express that bound, so the limit is
		# switched off here and the body is bounded by the relay instead: it caps
		# the body at limits.max_body_bytes and re-arms a 30s read deadline on
		# every read, so a stalled upload is cut while a slow one is not.
		timeouts {
			read_header 10s
			read_body 0
		}
	}
}

{$TPROXY_HOSTNAME} {
	# One backend serves the whole surface — the operator site, the bridge page
	# for a valid capability, and the API. Proxying every path (not just
	# `/` and `/api/v1/*`) keeps one public gateway for static or delegated
	# application responses and the transport. No file_server or separate
	# site route exposes different encoding, range, method, or proxy behavior.
	# `encode` wraps every response identically.
	encode zstd gzip
	header {
		-Via
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	reverse_proxy 127.0.0.1:8080 {
		transport http {
			response_header_timeout 40s
		}
	}

	# When the backend is down every path looks the same "backend unavailable",
	# which is indistinguishable from any other backend-down site; no path is
	# special-cased here.
	handle_errors {
		header {
			Cache-Control "no-store"
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
		}
		respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
	}
}
